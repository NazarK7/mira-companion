  !CW Received
  CONST num KI_DIN_READY:=1;
  CONST num KI_DIN_ACQUISITION_RUNNING:=2;
  CONST num KI_DIN_LIGHT_TRIGGERED:=4;
  CONST num KI_DIN_SYSTEM_ERROR:=6;
  !
  !Receive data errors
  CONST num KI_DATA_OK:=1000;
  CONST num KI_ID_ERROR:=1002;
  CONST num KI_ACQ_ERROR:=1003;
  CONST num KI_PAY_SIZE_ERROR:=1004;
  CONST num KI_NOTFOUND_ERROR:=1005;
  CONST num KI_TERM_ERROR:=1006;
  CONST num KI_OUTOFBOUND_MIRA_ERROR:=1007;
  CONST num KI_MIRA_SYSTEM_ERROR:=1008;
  CONST num KI_MIRA_CONNECTION_TIMEOUT:=1009;
