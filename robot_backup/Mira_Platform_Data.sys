  !TCP Connection
  PERS recMiraConfig_Parameter MiraConfigParameter:=["10.200.43.128",1024,0];
  PERS recMiraSendData MiraSendData;
  VAR recMiraReceiveData MiraReceiveData;
  VAR socketdev MiraVis_socket;
  !
  !Log
  VAR iodev MiraFile;
  PERS string MiraDictionary{85}:=[
        "Dictionary Loaded",
        "Installation Completed",
        "Payload dimension error",
        "TCP_IP started",
        "Connection closed",
        "Try connection...",
        "Connection established",
        "Connection not established",
        "Acquisition started",
        "Result OK",
        "Object not found",
        "Image too dark",
        "Feedback over threshold",
        "Feedback not ok",
        "Acquisition Time",
        "free",
        "Restart camera",
        "free",
        "X,Y,Z or Rx,Ry,Rz out of bounds",
        "Camera not ready",
        "Mira_platform acq_err: Camera Error",
        "Mira_platform acq_err: Job ID not correct",
        "Mira_platform acq_err: Job ID acquisition running",
        "Mira_platform Error acquisition",
        "free",
        "free",
        "free",
        "Mira_platform Timeout",
        "Mira_platform not connected",
        "Mira 3D critical system error",
        "Error code not recognize or multiple errors",
        "free",
        "JOB ID NOT CORRECT",
        "free",
        "free",
        "free",
        "free",
        "free",
        "free",
        "Termination error",
        "free",
        "free",
        "free",
        "free",
        "free",
        "free",
        "free",
        "free",
        "AUTOMATIC REPETITION: try number:",
        "free",
        "free",
        "User decision: IGNORE",
        "User decision: REPEAT THE MEASURE",
        "free",
        "free",
        "free",
        "free",
        "free",
        "free",
        "Start measurement cycle",
        "Lights error, repeat?",
        "Turning off the lights",
        "Repeat the measure",
        "free",
        "calculate the frame of the vision system",
        "free",
        "the current tool has been updated",
        "the current frame has been updated",
        "free",
        "maximum iteration number reached",
        "End of measurement cycle",
        "True",
        "Calibration finished",
        "Measure out of bound Mira",
        "Repeat lights command",
        "user ignore the problem with the lights",
        "Measure failed. RISK OF CRASH if ignore",
        "User ignore: correction applied with NULL OFFSET",
        "Applied a correction with NULL OFFSET",
        "Meas out of bounds. RISK OF CRASH if user ignore",
        "Offset out of bounds. RISK OF CRASH if user ignore",
        "RETRY to redo the measurement or IGNORE to collect with NULL OFFSET",
        "Payload reading Error",
        "Error in loading parameters from file",
        "/"];
  PERS bool MiraConfigParameterLoaded;
  VAR btnres MiraAnswer;
  VAR clock MiraClock;
  PERS num vi_MiraTime;
