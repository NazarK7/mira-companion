  PERS num vi_Mira_Last_Y_Received:=8.444;
  PERS num vi_Mira_Last_Z_Received:=-14.537;
  PERS num vi_Mira_Last_rX_Received:=0.191;
  PERS num vi_Mira_Last_rY_Received:=-0.917;
  PERS num vi_Mira_Last_rZ_Received:=0.181;
