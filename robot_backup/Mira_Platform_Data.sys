  PERS tooldata MiraVisionMasterTool:=[TRUE,[[-530.163,18.6214,335.565],[0.693107,-0.111135,0.110226,-0.703634]],[0.001,[0,0,0.001],[1,0,0,0],0,0,0]];
  PERS wobjdata MiraVisionwobj:=[FALSE,TRUE,"",[[-1346.5,2099.98,2773.13],[0.557835,-0.829764,-0.00569924,-0.0167312]],[[-3.285,-3.546,-12.708],[0.999999,0,0,-0.00129154]]];
  PERS num vi_MiraXTool;
  PERS num vi_MiraYTool;
  PERS num vi_MiraZTool;
  PERS num vi_MirarZ1Tool;
  PERS num vi_MirarYTool;
  PERS num vi_MirarZ2Tool;
  !Euler ZYX
  PERS num MiraZYX_rZ;
  PERS num MiraZYX_rY;
  PERS num MiraZYX_rX;
  !
  !Corrections
  PERS num vi_MiratempAngleX;
  PERS num vi_MiratempAngleY;
  PERS num vi_MiratempAngleZ;
  PERS bool vb_MiraCorr_X;
  PERS bool vb_MiraCorr_Y;
  PERS bool vb_MiraCorr_Z;
  PERS bool vb_MiraCorr_rX;
  PERS bool vb_MiraCorr_rY;
  PERS bool vb_MiraCorr_rZ;
  PERS num vi_MiraTh_Dx;
  PERS num vi_MiraTh_Dy;
  PERS num vi_MiraTh_Dz;
  PERS num vi_MiraTh_Rx;
  PERS num vi_MiraTh_Ry;
  PERS num vi_MiraTh_Rz;
  PERS num vi_MiraLim_Dx;
  PERS num vi_MiraLim_Dy;
  PERS num vi_MiraLim_Dz;
  PERS num vi_MiraLim_Rx;
  PERS num vi_MiraLim_Ry;
  PERS num vi_MiraLim_Rz;
  PERS num vi_Mira_Max_Dz;
