  !----------------------------------
  !Constants
  !----------------------------------
  !
  !CW Send
  CONST num KI_DOUT_START_ACQ:=2;
  CONST num KI_DOUT_LIGHT_TRIGGER:=4;
  CONST num KI_DOUT_ROBOT_ERROR:=5;
  CONST num KI_DOUT_RESET_ACQ_ERR:=7;
  CONST num KI_DOUT_RESET:=8;
  CONST num KI_DOUT_RESTART_CAMERA:=9;
