mMODULE Mira_Platform_Data(SYSMODULE,NOSTEPIN)
  !
  !***********************************************************
  !
  ! Module:  Mira_Platform_Data
  !
  ! Description:
  !   Mira Platform
  !   Main Data
  !
  ! Version: 1.0.6
  !
  !***********************************************************
  !
  !----------------------------------
  !Record
  !----------------------------------
  !
  RECORD recMiraConfig_Parameter
    string vs_ip_address;
    num vi_port;
    num lenguage_selected;
  ENDRECORD

  !
  RECORD recMiraSendData
    num CW;
    num ID;
    num X;
    num Y;
    num Z;
    num rX;
    num rY;
    num rZ;
    num Payload;
  ENDRECORD

  !
  RECORD recMiraReceiveData
    num CW;
    num ID;
    num AcqErr;
    num PayloadSize;
    num Result;
    num X;
    num Y;
    num Z;
    num rX;
    num rY;
    num rZ;
    string Term;
  ENDRECORD

  !
  !----------------------------------
  !User Variables
  !----------------------------------
  !
  PERS bool vb_MiraRetrySingleMeas;
  PERS num vi_Mira_Act_Attempt;
  PERS num vi_Mira_Act_Iteration;
  PERS num vi_Mira_n_Attempt;
  PERS num vi_Mira_n_Iteration;
  PERS bool vb_MiraReconnection;
  PERS bool vb_take_with_vision;
  PERS bool vb_nullOffset;
  PERS bool vb_MiraAcqErr;
  PERS bool vb_MiraSystErr;
  !
